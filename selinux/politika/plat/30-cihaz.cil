(allow mediaserver ion_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
(allow rs ion_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
(allow shell ion_device (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow surfaceflinger ion_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
(allow system_server sysfs_ion (file (ioctl read getattr lock map open watch watch_reads)))
(allow system_server ion_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
(allow zygote ion_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
(allow cameraserver camera2_extensions_prop (file (read getattr map open)))
(allow system_server camera2_extensions_prop (file (read getattr map open)))
(allow system_server storage_stub_file (dir (getattr)))
(allow fsck_untrusted self (capability (sys_admin)))
(allow linkerconfig self (capability (kill)))
(allow toolbox self (capability (kill)))
(allow rootfs labeledfs (filesystem (associate)))
(allow sdcardfs labeledfs (filesystem (associate)))
(allow vold self (capability (setgid setuid)))
(allow vold mnt_media_rw_stub_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow vold storage_stub_file (dir (ioctl read write getattr lock open watch watch_reads add_name remove_name search)))
(allow vold labeledfs (filesystem (relabelfrom)))
(typeattributeset property_type (sec_camera_prop sns_camera_light_prop vendor_persist_nfc_prop usb_uvc_config_prop xtra_control_prop))
(typeattributeset system_property_type (sec_camera_prop sns_camera_light_prop vendor_persist_nfc_prop usb_uvc_config_prop xtra_control_prop))
(typeattributeset system_public_property_type (sec_camera_prop sns_camera_light_prop vendor_persist_nfc_prop usb_uvc_config_prop))
