;; Legacy /dev/ion of the 4.19 kernel (mica's platform policy only knows dma-buf heaps) and
;; the LineageOS system_ext rules the tablet's vendor policy relies on (types it references
;; that mica's platform does not define or attribute).
(typeattribute gbos_ion_app)
(typeattributeset gbos_ion_app (and (appdomain ) (not (isolated_app_all ))))
(typeattribute gbos_ion_drm)
(typeattributeset gbos_ion_drm (and (hal_drm ) (not (hal_widevine_system ))))
(typeattribute gbos_ion_keymint)
(typeattributeset gbos_ion_keymint (and (hal_keymint_server ) (not (coredomain ))))
(allow adbd ion_device (chr_file (ioctl read write getattr lock append map open watch watch_reads)))
(allow gbos_ion_app ion_device (chr_file (ioctl read getattr lock map open watch watch_reads)))
