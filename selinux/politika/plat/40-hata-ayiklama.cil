(typeattributeset mlstrustedsubject (su))
(typeattributeset netdomain (su))
(allow adbd su (process (dyntransition sigchld)))
(allow su adbd (process (sigchld)))
(typeattribute gbos_su_binder_peer)
(typeattributeset gbos_su_binder_peer (and (domain ) (not (init ))))
(allow gbos_su_binder_peer su (binder (call transfer)))
