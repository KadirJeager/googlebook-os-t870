;; Other userdebug_or_eng rules of the same LineageOS platform policy that enforcing domains use
;; on a debuggable build: app heap dumps and method traces, adb remount's overlay_remounter,
;; atrace as a camera/vibrator HAL client, Wi-Fi HAL debug properties set from a vendor shell,
;; profcollect's ETR property.
(typeattributeset hal_camera_client (atrace))
(typeattributeset hal_vibrator_client (atrace))
(allow hal_camera atrace (memfd_file (read write getattr map)))
(allow hal_vibrator atrace (memfd_file (read write getattr map)))
(allow appdomain heapdump_data_file (file (append)))
(allow appdomain method_trace_data_file (dir (write lock open add_name remove_name search)))
(allow appdomain method_trace_data_file (file (write create lock append map open)))
(allow appdomain system_user_mode_emulation_prop (file (read getattr map open)))
(allow domain overlay_remounter (fd (use)))
(allow hal_wifi persist_vendor_debug_wifi_prop (file (read getattr map open)))
(allow vendor_shell init (unix_stream_socket (connectto)))
(allow vendor_shell property_socket (sock_file (write)))
(allow vendor_shell persist_vendor_debug_wifi_prop (property_service (set)))
(allow vendor_shell persist_vendor_debug_wifi_prop (file (read getattr map open)))
(allow vendor_init profcollectd_etr_prop (file (read getattr map open)))
