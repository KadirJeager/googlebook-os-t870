;; adb root on this debuggable build: adbd re-labels itself to su (selinux_android_setcon), like
;; on an AOSP userdebug build. mica's platform policy is a user build and has no rules towards su,
;; so enforcing domains could not reply to, signal or share fds/sockets with a root adb shell
;; (cmd/am callbacks, jdwp-control for app debugging, dumpsys pipes). These are the
;; userdebug_or_eng rules towards su of AOSP's platform policy, taken from the LineageOS 24
;; userdebug plat_sepolicy.cil; su itself stays a permissive domain as on userdebug.
(typepermissive su)
;; su.te (userdebug_or_eng): su is an app, a core and a network domain, a client of every HAL and
;; MLS-trusted, so that the enforcing domains it talks to (HAL callbacks, apps with categories)
;; treat it as they would on userdebug.
(typeattributeset appdomain (su))
(typeattributeset coredomain (su))
(typeattributeset hal_allocator_client (su))
(typeattributeset hal_atrace_client (su))
(typeattributeset hal_audio_client (su))
(typeattributeset hal_authsecret_client (su))
(typeattributeset hal_bluetooth_client (su))
(typeattributeset hal_bootctl_client (su))
(typeattributeset hal_camera_client (su))
(typeattributeset hal_cas_client (su))
(typeattributeset hal_configstore_client (su))
(typeattributeset hal_confirmationui_client (su))
(typeattributeset hal_contexthub_client (su))
(typeattributeset hal_drm_client (su))
(typeattributeset hal_dumpstate_client (su))
(typeattributeset hal_fingerprint_client (su))
(typeattributeset hal_gatekeeper_client (su))
(typeattributeset hal_gnss_client (su))
(typeattributeset hal_graphics_allocator_client (su))
(typeattributeset hal_graphics_composer_client (su))
(typeattributeset hal_health_client (su))
(typeattributeset hal_input_classifier_client (su))
(typeattributeset hal_ir_client (su))
(typeattributeset hal_keymaster_client (su))
(typeattributeset hal_light_client (su))
(typeattributeset hal_mediaquality_client (su))
(typeattributeset hal_memtrack_client (su))
(typeattributeset hal_neuralnetworks_client (su))
(typeattributeset hal_nfc_client (su))
(typeattributeset hal_oemlock_client (su))
(typeattributeset hal_power_client (su))
(typeattributeset hal_rebootescrow_client (su))
(typeattributeset hal_secretkeeper_client (su))
(typeattributeset hal_secure_element_client (su))
(typeattributeset hal_sensors_client (su))
(typeattributeset hal_telephony_client (su))
(typeattributeset hal_tetheroffload_client (su))
(typeattributeset hal_thermal_client (su))
(typeattributeset hal_tv_cec_client (su))
(typeattributeset hal_tv_hdmi_cec_client (su))
(typeattributeset hal_tv_hdmi_connection_client (su))
(typeattributeset hal_tv_hdmi_earc_client (su))
(typeattributeset hal_tv_input_client (su))
(typeattributeset hal_tv_tuner_client (su))
(typeattributeset hal_usb_client (su))
(typeattributeset hal_vibrator_client (su))
(typeattributeset hal_vm_capabilities_client (su))
(typeattributeset hal_vr_client (su))
(typeattributeset hal_weaver_client (su))
(typeattributeset hal_wifi_client (su))
(typeattributeset hal_wifi_hostapd_client (su))
(typeattributeset hal_wifi_supplicant_client (su))
