;; Rules found in the 2026-10-21 boot logs: LineageOS vendor domains, adb/shell debugging of the
;; bring-up. (The 32-bit HALs' system_file reads of that day were all /system/etc/ld.config.32;
;; the image builder now labels it system_linker_config_file from plat_file_contexts, which
;; every domain may read, so those rules are gone.)
(allow hal_lineage_touch_default vendor_sysfs_spen (dir (ioctl read getattr lock open watch watch_reads search)))
(allow hal_lineage_touch_default vendor_sysfs_spen (file (ioctl read write getattr lock append map open watch watch_reads)))
(allow gpuservice hal_graphics_mapper_hwservice (hwservice_manager (find)))
(allow gpuservice spu_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow system_server odsign_prop (file (read open getattr map)))
(allow system_server build_attestation_prop (file (read open getattr map)))
(allow system_server qemu_sf_lcd_density_prop (file (read open getattr map)))
(allow system_server system_server_tmpfs (file (read write execute map open getattr)))
(allow system_server idmap_exec (file (read open getattr execute execute_no_trans map)))
(allow adbd metadata_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow adbd metadata_file (file (ioctl read getattr lock map open watch watch_reads)))
(allow logd misc_logd_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow logd misc_logd_file (file (ioctl read getattr lock map open watch watch_reads)))
(allow vendor_init dqmdbg_file (dir (ioctl read write getattr lock relabelfrom relabelto open watch watch_reads search add_name remove_name)))
(allow vendor_init dqmdbg_file (file (ioctl read write getattr lock relabelfrom relabelto append map open watch watch_reads)))
(allow vendor_init dqmdbg_file (filesystem (relabelfrom relabelto associate)))
(allow bootanim bootanim_config_prop (file (read open getattr map)))
(allow system_server bootanim_config_prop (file (read open getattr map)))
(allow surfaceflinger bootanim_config_prop (file (read open getattr map)))
(allow system_server system_user_mode_emulation_prop (file (read open getattr map)))
(allow system_server binderfs_logs_transactions (file (read open getattr)))
(allow zygote self (capability (kill)))
(allow crash_dump vold (process (ptrace)))
(allow boringssl_self_test tmpfs (chr_file (read write getattr open)))
(allow shell kernel (system (syslog_read)))
(allow shell metadata_file (dir (ioctl read getattr lock open watch watch_reads search)))
(allow shell proc_last_kmsg (file (ioctl read getattr lock map open watch watch_reads)))
(allow shell pstorefs (dir (ioctl read getattr lock open watch watch_reads search)))
(allow shell pstorefs (file (ioctl read getattr lock map open watch watch_reads)))
