 namespace sensors {
 namespace implementation {
 
+namespace orientation = ::gbos::natural_orientation;
+using ::android::hardware::sensors::V1_0::SensorFlagBits;
+using ::android::hardware::sensors::V2_0::implementation::ScopedWakelock;
+using HidlEvent = ::android::hardware::sensors::V2_1::Event;
+
+namespace {
+
+constexpr int32_t kTypeMetaData = 0;        // SensorType::META_DATA (flush complete)
+constexpr int32_t kTypeAdditionalInfo = 33;  // SensorType::ADDITIONAL_INFO
+
+const char* kindName(orientation::Kind kind) {
+    switch (kind) {
+        case orientation::Kind::kUnchanged: return "unchanged";
+        case orientation::Kind::kVector3: return "vector";
+        case orientation::Kind::kUncalibrated3: return "vector+bias";
+        case orientation::Kind::kLimitedAxes: return "limited-axes vector";
+        case orientation::Kind::kLimitedAxesUncal: return "limited-axes vector+bias";
+        case orientation::Kind::kQuaternion: return "quaternion";
+        case orientation::Kind::kDeviceOrientation: return "device orientation";
+        case orientation::Kind::kHeading: return "heading";
+        case orientation::Kind::kAdditionalInfo: return "additional info";
+        case orientation::Kind::kHidden: return "hidden";
+    }
+    return "?";
+}
+
+// The 64-byte EventPayload union through a float array (natural_orientation.h works on that).
+bool rotateEvent(orientation::Kind kind, HidlEvent* event, int rotation) {
+    float data[16];
+    static_assert(sizeof(event->u) == sizeof(data), "EventPayload is 16 words");
+    std::memcpy(data, &event->u, sizeof(data));
+    if (!orientation::rotate_payload(kind, data, rotation)) return false;
+    std::memcpy(&event->u, data, sizeof(data));
+    return true;
+}
+
+}  // namespace
+
+HalProxySamsung::HalProxySamsung() {
+    for (const auto& [handle, sensor] : getSensors()) {
+        const uint32_t flags = sensor.flags;
+        if (flags & static_cast<uint32_t>(SensorFlagBits::DYNAMIC_SENSOR)) continue;
+        const auto kind = orientation::kind_of(static_cast<int32_t>(sensor.type));
+        mFrameInfo[handle] = {kind, (flags & static_cast<uint32_t>(SensorFlagBits::WAKE_UP)) != 0};
+        if (kind == orientation::Kind::kHidden) {
+            ALOGE("natural orientation: %s (%#x, type %d) reports device-frame data without a "
+                  "defined transform; not offered",
+                  sensor.name.c_str(), handle, static_cast<int32_t>(sensor.type));
+        } else if (kind != orientation::Kind::kUnchanged) {
+            ALOGI("natural orientation: %s (%#x): %s, panel rotation %d", sensor.name.c_str(),
+                  handle, kindName(kind), orientation::kPanelRotation);
+        }
+    }
+}
+
+orientation::Kind HalProxySamsung::frameKind(int32_t sensorHandle, int32_t eventType) const {
+    auto it = mFrameInfo.find(sensorHandle);
+    if (it == mFrameInfo.end() || eventType == kTypeMetaData) return orientation::Kind::kUnchanged;
+    if (eventType == kTypeAdditionalInfo) return orientation::Kind::kAdditionalInfo;
+    return it->second.kind;
+}
+
+void HalProxySamsung::postEventsToMessageQueue(const std::vector<HidlEvent>& events,
+                                               size_t numWakeupEvents, ScopedWakelock wakelock) {
+    std::vector<HidlEvent> rotated;
+    rotated.reserve(events.size());
+    for (const HidlEvent& event : events) {
+        HidlEvent out = event;
+        if (!rotateEvent(frameKind(out.sensorHandle, static_cast<int32_t>(out.sensorType)), &out,
+                         orientation::kPanelRotation)) {
+            // A hidden sensor is not in the framework's list; its event has no reader.
+            if (mFrameInfo.at(out.sensorHandle).wakeUp && numWakeupEvents > 0) numWakeupEvents--;
+            continue;
+        }
+        rotated.push_back(out);
+    }
+    if (rotated.empty()) return;
+    HalProxy::postEventsToMessageQueue(rotated, numWakeupEvents, std::move(wakelock));
+}
+
+ndk::ScopedAStatus HalProxySamsung::injectSensorData(
+        const ::aidl::android::hardware::sensors::Event& in_event) {
+    if (mFrameInfo.find(in_event.sensorHandle) == mFrameInfo.end()) {
+        return HalProxyAidl::injectSensorData(in_event);
+    }
+    HidlEvent hidlEvent;
+    convertToHidlEvent(in_event, &hidlEvent);
+    // Injected data is in the natural orientation's frame; the sub-HAL expects the panel's.
+    if (!rotateEvent(frameKind(hidlEvent.sensorHandle, static_cast<int32_t>(hidlEvent.sensorType)),
+                     &hidlEvent, -orientation::kPanelRotation)) {
+        return ndk::ScopedAStatus::fromExceptionCode(EX_ILLEGAL_ARGUMENT);
+    }
+    ::aidl::android::hardware::sensors::Event panelEvent;
+    convertToAidlEvent(hidlEvent, &panelEvent);
+    return HalProxyAidl::injectSensorData(panelEvent);
+}
+
+binder_status_t HalProxySamsung::dump(int fd, const char** args, uint32_t numArgs) {
+    std::string out = ::android::base::StringPrintf(
+            "Googlebook OS natural orientation (dogal-yon/hal): panel rotation %d\n",
+            orientation::kPanelRotation);
+    for (const auto& [handle, info] : mFrameInfo) {
+        if (info.kind == orientation::Kind::kUnchanged) continue;
+        out += ::android::base::StringPrintf("  %#010x %s\n", handle, kindName(info.kind));
+    }
+    ::android::base::WriteStringToFd(out, fd);
+    return HalProxyAidl::dump(fd, args, numArgs);
+}
+
 ndk::ScopedAStatus HalProxySamsung::getSensorsList(
         std::vector<::aidl::android::hardware::sensors::SensorInfo>* _aidl_return) {
     for (const auto& sensor : HalProxy::getSensors()) {
         SensorInfo dst = sensor.second;
 
+        if (frameKind(sensor.first, static_cast<int32_t>(dst.type)) ==
+            orientation::Kind::kHidden) {
+            continue;
+        }
+
         if (dst.requiredPermission == "com.samsung.permission.SSENSOR") {
             dst.requiredPermission = "";
         }
