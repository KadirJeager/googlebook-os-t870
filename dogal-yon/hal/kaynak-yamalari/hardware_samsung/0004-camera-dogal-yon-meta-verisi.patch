+void convertToAidlNaturalOrientation(const camera_metadata_t* src, CameraMetadata* dest) {
+    if (src != nullptr &&
+        ::gbos::natural_orientation::rotate_camera_metadata(src, &dest->metadata)) {
+        return;
+    }
+    convertToAidl(src, dest);
+}
