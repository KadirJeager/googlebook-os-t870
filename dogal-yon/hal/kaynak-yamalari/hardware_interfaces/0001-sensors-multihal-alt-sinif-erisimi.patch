Sensors AIDL multi-HAL: the ISensors overrides of HalProxyAidl are protected, so a vendor subclass
(LineageOS HalProxySamsung) can wrap injectSensorData and dump and call the implementation.

--- a/sensors/aidl/default/multihal/include/HalProxyAidl.h
+++ b/sensors/aidl/default/multihal/include/HalProxyAidl.h
@@ -27,6 +27,9 @@
 
 class HalProxyAidl : public ::android::hardware::sensors::V2_1::implementation::HalProxy,
                      public ::aidl::android::hardware::sensors::BnSensors {
+    // Protected, not private (Googlebook OS, T870-araclar/dogal-yon/hal): vendor subclasses such
+    // as LineageOS's HalProxySamsung extend these calls and still reach the implementation.
+  protected:
     ::ndk::ScopedAStatus activate(int32_t in_sensorHandle, bool in_enabled) override;
     ::ndk::ScopedAStatus batch(int32_t in_sensorHandle, int64_t in_samplingPeriodNs,
                                int64_t in_maxReportLatencyNs) override;
