#!/system/bin/sh
# Googlebook OS (SM-T870) installer, run by recovery from the signed package (kurulum.zip,
# copied by the tablet as /cache/gbos/kur.zip or /cache/gbos/geri.zip).
#
# Recovery calls: update-binary <api> <status fd> <package path> [retry]
#   .../kur.zip   install the new images ("yeni"); the running ones ("eski") are the way back
#   .../geri.zip  write the previous images ("eski") back
#
# The tablet prepares everything in /cache/gbos before it reboots into recovery
# (gbos-guncelleyici kur / geri, cihaz/gbos-guncelleyici):
#   islem.conf           what to write (format below)
#   yeni-<bolum>.map     AOSP uncrypt block maps of /data/gbos-ota/yeni/<bolum>.img
#   eski-<bolum>.map     ... and of /data/gbos-ota/eski/<bolum>.img, the running images
# /data is file-based encrypted; uncrypt rewrote those blocks in plaintext on the raw userdata
# device, so they are read from there through the maps, without mounting /data.
#
# Order: every source image is read and hashed first (in kur mode the previous images too, so a
# failed write can always be undone); only then is super written, read back and hashed. If the
# new images do not read back correctly the previous ones are written back. The slots this script
# may write are fixed below for each Googlebook OS super header it knows (generated by
# kurtarma/paket.py from tablete-yaz.py); islem.conf must name exactly the slots of the header the
# images are made for. The LineageOS half of super is never touched.
#
# Super header change: when the images are made for a newer header than the one in super
# (super_baslik_hedef), kur writes that header first, then the images. Every slot of the older
# header starts where the newer one's does and is not larger, so whatever the slots hold still
# mounts under the newer header if the writes are interrupted. Rolling back (geri, or a failed
# install) writes the previous images and then the previous header. Both headers are 1 MiB files
# in /cache/gbos whose hashes must be headers this script knows.
#
# Exit: 0 whenever super holds a complete, verified image set; recovery then reboots into it.
# When super is not known to be consistent (or a rollback the boot guard asked for cannot run),
# the script does not return to recovery's reboot: it writes a bootloader message that keeps the
# tablet in recovery with the text log on screen and reboots into recovery (stay_in_recovery).
# A power loss in the middle is safe: recovery keeps its command in the BCB and runs this again,
# and the boot guard sends a half-written system straight back here (/cache/gbos/yaziliyor).
#
# islem.conf (one item per line, '#' comments):
#   bicim 1
#   surum_yeni <build>  surum_eski <build>
#   neden kullanici|bekci           who asked (geri)
#   super_baslik_sha256 <sha>       hash of super's first MiB (the LP header) before the install
#   super_baslik_hedef <sha>        the header the images are made for (optional, default: same);
#                                   when it differs: baslik-hedef.bin and baslik-onceki.bin
#   bolum <ad> <ilk_mib> <boyut_mib> <bayt> <yeni_sha> <eski_sha>
#
# Results: /cache/gbos/sonuc (one line), /cache/gbos/deneme after an install (the boot guard
# counts the trial boots there), log in /cache/gbos/kurulum.log.
# mksh arithmetic is 32-bit: all sizes are kept in 4 KiB blocks or MiB.

API="$1"
STATUS_FD="$2"
PACKAGE="$3"
BLOCK=4096

# Slots for each known super header: "<header sha> <name> <first MiB> <MiB> ..." (paket.py).
SLOT_TABLE="@@SLOT_TABLE@@"

if [ "$GBOS_TEST" = 1 ]; then
    # Only the tests on the computer set this (guncelleyici/testler); recovery never does.
    DIR="$GBOS_DIZIN" SUPER="$GBOS_SUPER" USERDATA="$GBOS_USERDATA" MISC="$GBOS_MISC"
else
    DIR=/cache/gbos
    SUPER=/dev/block/by-name/super
    USERDATA=/dev/block/by-name/userdata
    MISC=/dev/block/by-name/misc
fi
LOG="$DIR/kurulum.log"
CONF="$DIR/islem.conf"

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"
}
ui() {
    [ -n "$STATUS_FD" ] && printf 'ui_print %s\nui_print\n' "$*" > "/proc/self/fd/$STATUS_FD" 2>/dev/null
    log "$*"
}
progress() {  # fraction of the bar, seconds
    [ -n "$STATUS_FD" ] && printf 'progress %s %s\n' "$1" "$2" > "/proc/self/fd/$STATUS_FD" 2>/dev/null
}
result() {
    printf '%s\n' "$*" > "$DIR/sonuc.tmp" && sync && mv "$DIR/sonuc.tmp" "$DIR/sonuc" && sync
    log "SONUC: $*"
}
is_number() { case "$1" in ''|*[!0-9]*) return 1 ;; esac; [ ${#1} -le 12 ]; }
is_sha() { case "$1" in *[!0-9a-f]*) return 1 ;; esac; [ ${#1} -eq 64 ]; }
is_build() { case "$1" in ''|*[!0-9A-Za-z._-]*) return 1 ;; esac; }
is_dev() { [ -b "$1" ] || { [ "$GBOS_TEST" = 1 ] && [ -f "$1" ]; }; }

dev_blocks() {  # $1 device: size in 4 KiB blocks
    if [ -b "$1" ]; then
        local sectors
        sectors=$(blockdev --getsz "$1") || return 1
        echo $((sectors / 8))
    else
        local bytes
        bytes=$(stat -c %s "$1") || return 1
        echo $((bytes / BLOCK))
    fi
}

# Keeps the tablet in recovery with the log on screen: a bootloader message "boot-recovery" with
# --show_text (bootable/recovery bootloader_message: command[32] status[32] recovery[768] at the
# start of misc), then a reboot whose reason ("recovery") the Samsung kernel turns into
# PON_RESTART_REASON_RECOVERY. Recovery never reaches its own reboot into the inconsistent
# system. Does not return.
stay_in_recovery() {
    local msg="$DIR/bcb.$$"
    ui "Tablet kurtarma modunda bekletiliyor; bilgisayardan tablete-yaz.py ile kurtarılabilir."
    dd if=/dev/zero of="$msg" bs=832 count=1 2>/dev/null
    printf 'boot-recovery' | dd of="$msg" bs=1 seek=0 conv=notrunc 2>/dev/null
    printf 'recovery\n--show_text\n' | dd of="$msg" bs=1 seek=64 conv=notrunc 2>/dev/null
    if dd if="$msg" of="$MISC" bs=832 count=1 conv=notrunc,fsync 2>>"$LOG" &&
        [ "$(dd if="$MISC" bs=832 count=1 2>/dev/null | sha256sum | cut -d' ' -f1)" = \
          "$(sha256sum "$msg" | cut -d' ' -f1)" ]; then
        log "bootloader message written: stay in recovery"
    else
        log "bootloader message could not be written"
    fi
    rm -f "$msg"
    sync
    if [ "$GBOS_TEST" = 1 ]; then
        echo "STAY_IN_RECOVERY" >> "$DIR/test-reboot"
        exit 3
    fi
    reboot recovery
    sleep 60
    exit 1
}

die() {  # super is not known to be consistent
    ui "HATA: $*"
    ui "Sistem bölümleri tutarlı değil."
    result "felaket $*"
    stay_in_recovery
}

# Checks that a block map is well formed, names the userdata device and covers exactly the
# expected number of blocks, all inside the device. $1 map, $2 size in bytes (string, may exceed
# 32 bits), $3 expected blocks
map_check() {
    local map="$1" size="$2" blocks="$3" dev line2 count total s e n limit
    [ -f "$map" ] || { log "harita yok: $map"; return 1; }
    { read -r dev; read -r line2; read -r count; } < "$map"
    is_dev "$dev" || { log "$map: blok aygıtı yok: $dev"; return 1; }
    [ "$(readlink -f "$dev")" = "$(readlink -f "$USERDATA")" ] ||
        { log "$map: aygıt $dev userdata değil ($USERDATA)"; return 1; }
    [ "$line2" = "$size $BLOCK" ] || { log "$map: boyut '$line2', beklenen '$size $BLOCK'"; return 1; }
    is_number "$count" || { log "$map: aralık sayısı '$count'"; return 1; }
    limit=$(dev_blocks "$dev") || { log "$map: aygıt boyu okunamadı"; return 1; }
    total=0
    n=0
    while read -r s e; do
        n=$((n + 1))
        [ $n -le 3 ] && continue
        is_number "$s" && is_number "$e" && [ "$e" -gt "$s" ] && [ "$e" -le "$limit" ] ||
            { log "$map: geçersiz aralık '$s $e' (aygıt $limit blok)"; return 1; }
        total=$((total + e - s))
    done < "$map"
    [ $((n - 3)) -eq "$count" ] || { log "$map: $((n - 3)) aralık, başlık $count diyor"; return 1; }
    [ "$total" -eq "$blocks" ] || { log "$map: $total blok, beklenen $blocks"; return 1; }
    return 0
}

map_cat() {  # $1 map: the mapped bytes in file order
    local dev n s e
    read -r dev < "$1"
    n=0
    while read -r s e; do
        n=$((n + 1))
        [ $n -le 3 ] && continue
        dd if="$dev" bs=$BLOCK skip="$s" count=$((e - s)) 2>/dev/null || return 1
    done < "$1"
}

map_sha() {  # $1 map
    map_cat "$1" | sha256sum | cut -d' ' -f1
}

map_write() {  # $1 map, $2 first MiB of the slot in super
    local dev n s e at
    read -r dev < "$1"
    at=$(($2 * 256))
    n=0
    while read -r s e; do
        n=$((n + 1))
        [ $n -le 3 ] && continue
        dd if="$dev" of="$SUPER" bs=$BLOCK skip="$s" seek="$at" count=$((e - s)) conv=notrunc \
            2>>"$LOG" || return 1
        at=$((at + e - s))
    done < "$1"
}

slot_sha() {  # $1 first MiB, $2 MiB
    dd if="$SUPER" bs=1048576 skip="$1" count="$2" 2>/dev/null | sha256sum | cut -d' ' -f1
}

slot_of() {  # $1 header sha, $2 name: "<first MiB> <MiB>" from SLOT_TABLE
    local sha="$1" name="$2"
    set -- $SLOT_TABLE
    while [ $# -ge 4 ]; do
        [ "$1" = "$sha" ] && [ "$2" = "$name" ] && { echo "$3 $4"; return 0; }
        shift 4
    done
    return 1
}

known_header() {  # $1 sha: a header SLOT_TABLE has slots for
    case " $SLOT_TABLE " in *" $1 "*) return 0 ;; esac
    return 1
}

write_header() {  # $1 file (1 MiB), $2 its sha: writes it as super's first MiB and reads it back
    ui "Super başlığı yazılıyor"
    dd if="$1" of="$SUPER" bs=1048576 count=1 conv=notrunc 2>>"$LOG" || { log "başlık yazılamadı"; return 1; }
    drop_caches
    [ "$(slot_sha 0 1)" = "$2" ] || { log "başlık yuvadan $2 okunmuyor"; return 1; }
    ui "Doğrulandı: super başlığı"
}

drop_caches() {
    sync
    echo 3 > /proc/sys/vm/drop_caches 2>/dev/null || log "drop_caches yazılamadı"
}

# --- configuration ---------------------------------------------------------------------------

mkdir -p "$DIR" || exit 1
log "=== update-binary api=$API paket=$PACKAGE ${4:-}"
[ -f "$DIR/yaziliyor" ] && log "önceki çalışma yazarken kesilmiş: $(cat "$DIR/yaziliyor"); baştan başlanıyor"
case "${PACKAGE##*/}" in
    kur.zip) MODE=kur; SRC=yeni ;;
    geri.zip) MODE=geri; SRC=eski ;;
    *) ui "Bilinmeyen paket adı: $PACKAGE"; result "yapilmadi paket-adi"; exit 0 ;;
esac

REASON=kullanici
# In geri mode a failure before anything is written leaves the system that is being rolled back.
# When the boot guard asked for the rollback that system does not boot: stay in recovery instead
# of rebooting into it again.
abort_unchanged() {
    ui "Kurulum yapılmadı: $*"
    result "yapilmadi $MODE $*"
    if [ "$MODE" = geri ] && [ "$REASON" = bekci ]; then
        stay_in_recovery
    fi
    exit 0
}
[ -f "$CONF" ] || abort_unchanged "islem-yok"

NAMES=""
FORMAT=""
while read -r key a b c d e f extra; do
    case "$key" in
        bicim) FORMAT="$a" ;;
        surum_yeni) is_build "$a" || abort_unchanged "islem-bozuk surum_yeni"; NEW_BUILD="$a" ;;
        surum_eski) is_build "$a" || abort_unchanged "islem-bozuk surum_eski"; OLD_BUILD="$a" ;;
        neden)
            case "$a" in kullanici|bekci) REASON="$a" ;; *) abort_unchanged "islem-bozuk neden" ;; esac ;;
        super_baslik_sha256) is_sha "$a" || abort_unchanged "islem-bozuk super_baslik"; HEADER_SHA="$a" ;;
        super_baslik_hedef) is_sha "$a" || abort_unchanged "islem-bozuk super_baslik_hedef"; TARGET_SHA="$a" ;;
        bolum)  # ad ilk_mib boyut_mib bayt yeni_sha eski_sha
            [ -z "$extra" ] || abort_unchanged "islem-bozuk $a fazla alan"
            case "$a" in system|system_ext|product) ;; *) abort_unchanged "islem-bozuk bölüm $a" ;; esac
            case " $NAMES " in *" $a "*) abort_unchanged "islem-bozuk $a iki kez" ;; esac
            is_number "$b" && is_number "$c" && is_number "$d" || abort_unchanged "islem-bozuk $a sayıları"
            is_sha "$e" && is_sha "$f" || abort_unchanged "islem-bozuk $a özetleri"
            NAMES="$NAMES $a"
            eval "FIRST_$a=$b SIZE_$a=$c BYTES_$a=$d SHA_yeni_$a=$e SHA_eski_$a=$f" ;;
        ''|'#'*) ;;
        *) abort_unchanged "islem-bozuk satır $key" ;;
    esac
done < "$CONF"
[ "$FORMAT" = 1 ] || abort_unchanged "islem-bozuk biçim '$FORMAT'"
[ -n "$NAMES" ] && [ -n "$HEADER_SHA" ] && [ -n "$OLD_BUILD" ] || abort_unchanged "islem-eksik"
[ "$MODE" = geri ] || [ -n "$NEW_BUILD" ] || abort_unchanged "islem-eksik surum_yeni"

if [ "$MODE" = kur ]; then
    ui "Googlebook OS $NEW_BUILD kuruluyor (önceki: $OLD_BUILD)"
else
    ui "Önceki sürüme dönülüyor: $OLD_BUILD"
fi

# The slots must be exactly the ones fixed for the header the images are made for; super holds
# that header or the one it had before the install (a run interrupted after the header was
# written, or a rollback of a header change).
[ -n "$TARGET_SHA" ] || TARGET_SHA="$HEADER_SHA"
known_header "$HEADER_SHA" || abort_unchanged "bilinmeyen super başlığı $HEADER_SHA"
known_header "$TARGET_SHA" || abort_unchanged "bilinmeyen hedef super başlığı $TARGET_SHA"
is_dev "$SUPER" || abort_unchanged "super bölümü bulunamadı"
HEADER_NOW=$(dd if="$SUPER" bs=1048576 count=1 2>/dev/null | sha256sum | cut -d' ' -f1)
[ "$HEADER_NOW" = "$HEADER_SHA" ] || [ "$HEADER_NOW" = "$TARGET_SHA" ] ||
    abort_unchanged "beklenmeyen super başlığı $HEADER_NOW"
SUPER_MIB=$(( $(dev_blocks "$SUPER") / 256 ))
for name in $NAMES; do
    eval "first=\$FIRST_$name size=\$SIZE_$name bytes=\$BYTES_$name"
    [ "$(slot_of "$TARGET_SHA" "$name")" = "$first $size" ] ||
        abort_unchanged "yuva $name $first+$size bu başlık için tanımlı değil"
    if [ "$HEADER_SHA" != "$TARGET_SHA" ]; then
        old=$(slot_of "$HEADER_SHA" "$name") || abort_unchanged "önceki başlıkta $name yuvası yok"
        [ "${old% *}" = "$first" ] && [ "${old#* }" -le "$size" ] ||
            abort_unchanged "önceki başlığın $name yuvası ($old) yenisinin içinde değil"
    fi
    # toybox expr is 64-bit; mksh's $(( )) would wrap for the 3096 MiB product slot
    [ "$bytes" = "$(expr "$size" \* 1048576)" ] || abort_unchanged "yuva $name bayt sayısı $bytes"
    [ $((first + size)) -le "$SUPER_MIB" ] || abort_unchanged "yuva $name super dışına taşıyor"
done

# --- read and check every source before writing ----------------------------------------------

progress 0.30 300
if [ "$HEADER_SHA" != "$TARGET_SHA" ]; then
    for h in hedef:$TARGET_SHA onceki:$HEADER_SHA; do
        f="$DIR/baslik-${h%%:*}.bin"
        [ -f "$f" ] && [ "$(stat -c %s "$f")" = 1048576 ] || abort_unchanged "$f yok"
        [ "$(sha256sum "$f" | cut -d' ' -f1)" = "${h#*:}" ] || abort_unchanged "$f bozuk"
    done
fi
CHECK_SETS="$SRC"
[ "$MODE" = kur ] && CHECK_SETS="yeni eski"
for set in $CHECK_SETS; do
    for name in $NAMES; do
        eval "size=\$SIZE_$name bytes=\$BYTES_$name want=\$SHA_${set}_$name"
        map="$DIR/$set-$name.map"
        ui "Denetleniyor: $set $name"
        map_check "$map" "$bytes" $((size * 256)) || abort_unchanged "$set $name blok haritası geçersiz"
        got=$(map_sha "$map")
        if [ "$got" != "$want" ]; then
            log "$set $name: okunan $got, beklenen $want"
            abort_unchanged "$set $name imajı bozuk okunuyor"
        fi
    done
done

# --- write -----------------------------------------------------------------------------------

write_set() {  # $1 yeni|eski; returns 1 if a slot does not read back as expected
    local set="$1" name first size want got bad=0
    for name in $NAMES; do
        eval "first=\$FIRST_$name"
        ui "Yazılıyor: $name"
        map_write "$DIR/$set-$name.map" "$first" || { log "$name: yazma hatası"; bad=1; }
    done
    drop_caches
    for name in $NAMES; do
        eval "first=\$FIRST_$name size=\$SIZE_$name want=\$SHA_${set}_$name"
        got=$(slot_sha "$first" "$size")
        if [ "$got" = "$want" ]; then
            ui "Doğrulandı: $name"
        else
            log "$name: yuvadan okunan $got, beklenen $want"
            ui "Doğrulanamadı: $name"
            bad=1
        fi
    done
    return $bad
}

# Back to the header super had before the install (geri, a failed install).
restore_header() {
    [ "$HEADER_SHA" = "$TARGET_SHA" ] && return 0
    [ "$(slot_sha 0 1)" = "$HEADER_SHA" ] && return 0
    write_header "$DIR/baslik-onceki.bin" "$HEADER_SHA"
}

printf '%s %s\n' "$MODE" "${PACKAGE##*/}" > "$DIR/yaziliyor.tmp" && mv "$DIR/yaziliyor.tmp" "$DIR/yaziliyor"
sync
progress 0.40 400
if [ "$MODE" = kur ] && [ "$HEADER_NOW" != "$TARGET_SHA" ]; then
    if ! write_header "$DIR/baslik-hedef.bin" "$TARGET_SHA"; then
        restore_header || die "super başlığı ne yeni ne önceki haliyle yazılabildi"
        rm -f "$DIR/yaziliyor"
        sync
        abort_unchanged "super başlığı yazılamadı"
    fi
fi
if write_set "$SRC"; then
    if [ "$MODE" = geri ]; then
        restore_header || die "önceki imajlar yazıldı ama önceki super başlığı yazılamadı"
    fi
    if [ "$MODE" = kur ]; then
        printf 'durum=deneme\nsurum_yeni=%s\nsurum_eski=%s\nsayac=0\n' \
            "$NEW_BUILD" "$OLD_BUILD" > "$DIR/deneme.tmp"
        mv "$DIR/deneme.tmp" "$DIR/deneme"
        result "kuruldu $NEW_BUILD"
        ui "Kurulum tamam. Yeni sürüm açılıyor; açılmazsa önceki sürüme kendiliğinden dönülür."
    else
        rm -f "$DIR/deneme"
        result "geri-donuldu $OLD_BUILD $REASON"
        ui "Önceki sürüme dönüldü."
    fi
    rm -f "$DIR/yaziliyor"
    sync
    progress 0.05 1
    exit 0
fi

[ "$MODE" = geri ] && die "önceki imajlar yazıldı ama doğrulanamadı"
ui "Yeni imajlar doğrulanamadı; önceki sürüm geri yazılıyor."
progress 0.05 400
if write_set eski && restore_header; then
    rm -f "$DIR/deneme"
    result "kurulamadi-geri-yuklendi $NEW_BUILD"
    ui "Önceki sürüm geri yüklendi; tablet onunla açılacak."
    rm -f "$DIR/yaziliyor"
    sync
    exit 0
fi
die "yeni imajlar doğrulanamadı, önceki sürüm de tam geri yazılamadı"
