<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@color/zemin</item>
        <item name="android:colorBackground">@color/zemin</item>
        <item name="android:colorAccent">@color/vurgu</item>
        <item name="android:colorPrimary">@color/zemin</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Baslik" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/metin</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="Govde" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
        <item name="android:textColor">@color/ikincil_metin</item>
    </style>
    <style name="SatirBaslik" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/metin</item>
    </style>
    <style name="Ikincil" parent="@android:style/TextAppearance.DeviceDefault">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/ikincil_metin</item>
    </style>
    <style name="DoluDugme" parent="@android:style/Widget.DeviceDefault.Button.Colored">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/dugme_metni</item>
        <item name="android:backgroundTint">@color/vurgu</item>
    </style>
    <style name="MetinDugmesi" parent="@android:style/Widget.DeviceDefault.Button.Borderless.Colored">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/vurgu</item>
    </style>
</resources>
